{
  "name": "@aiwayds/dsh-opentui-bridge",
  "version": "0.1.0",
  "description": "In-process session bridge bundle for dsh-opentui — stdio JSON-lines seam (session.open/send/close/list, turn.abort, ask.response, journal.replay) plus the append-system section provider",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./approval-gate": {
      "default": "./approval-gate.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "approval-gate.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-bridge.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
