{
  "name": "@aiwayds/dsh-opentui",
  "version": "0.4.2",
  "type": "module",
  "bin": {
    "dsh-opentui": "bin/dsh-opentui.mjs"
  },
  "main": "./dist-host/index.js",
  "exports": {
    ".": "./dist-host/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist-host/plugin.patch.yml"
    }
  },
  "files": [
    "dist-host",
    "bin",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "build:bin": "bun build.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "smoke": "node scripts/smoke-boot.mjs",
    "test:e2e": "node scripts/e2e-live.mjs && node scripts/e2e-fork.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/bun": "latest",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@dsh-opentui/runtime": "workspace:*",
    "@dsh-opentui/kit": "workspace:*"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}
