{
  "name": "@aiwayds/dsh-opentui",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dsh-opentui": "bin/dsh-opentui.mjs"
  },
  "main": "./dist-host/index.js",
  "exports": {
    ".": "./dist-host/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist-host/plugin.patch.yml"
    }
  },
  "files": [
    "dist-host",
    "bin",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "client": "bun src/client-entry.tsx",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "node scripts/pack-meta.mjs",
    "smoke": "node scripts/smoke-boot.mjs",
    "sync": "node scripts/sync-profile.mjs",
    "test:e2e": "node scripts/e2e-live.mjs && node scripts/e2e-fork.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.8.2",
    "@opentui/solid": "0.8.2",
    "@opentui/keymap": "0.8.2",
    "solid-js": "1.9.17",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/bun": "latest",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@dsh-opentui/runtime": "workspace:*"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}
