{
  "name": "@aiwayds/dsh-opentui",
  "version": "0.18.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-opentui.git",
    "directory": "packages/shell"
  },
  "type": "module",
  "bin": {
    "dsh-opentui": "bin/dsh-opentui.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "dist/client",
    "dist/bridge",
    "dist/scripts",
    "dist/locales",
    "dist/host-launch.mjs",
    "dist/host-launch.mjs.map",
    "dist/watchdog.mjs",
    "dist/watchdog.mjs.map",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "client": "bun src/client-entry.tsx",
    "typecheck": "tsc --noEmit",
    "prepack": "bun ../../scripts/build-bridge.mjs && bun ../../scripts/build-client.mjs && bun ../../scripts/verify-pack-locales.mjs && node scripts/pack-meta.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.8.1",
    "@opentui/keymap": "0.8.1",
    "@opentui/solid": "0.8.1",
    "solid-js": "1.9.17",
    "ws": "^8.22.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@dsh-opentui/runtime": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=26.4.0",
    "bun": ">=1.3.14"
  }
}
