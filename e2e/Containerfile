# e2e image for dsh-opentui: Ubuntu 24.04 + Node 26 + tmux + a global dsh
# install + bun + the workspace snapshot at /src (batch B5: the client face
# is the only face — ADR-0005, the --plugin chain was removed in batch B4
# and the former plugin-face layers here (tarball global install +
# install-profile bake + jev bake) are gone with it).
#
# Runtime choice: CLIENT mode. The scenario suite boots the repo-root
# `./dsh-opentui` launcher (bun --preload ... client-entry.tsx), which
# spawns/joins the resident `dsh --profile opentui` host through the
# single-instance lifecycle (packages/shell/src/client/lifecycle.ts). The
# opentui profile is NOT baked: start_tui / ensure_client_profile provisions
# it at runtime into the scratch DSH_HOME from the workspace snapshot.
#
# Node 26 is a HARD requirement (not 22): OpenTUI's native core needs
# node's --experimental-ffi (shell README: node >= 26.4); node 22 rejects
# the flag as a bad option and the resident host would die.
#
# The base image is pulled through the DaoCloud mirror because
# registry-1.docker.io is not reachable from the dev machine's podman VM
# (DNS-poisoned). On a network where docker.io works, drop the
# "docker.m.daocloud.io/" prefix.
FROM docker.m.daocloud.io/library/ubuntu:24.04

# >= 26.4 for --experimental-ffi (matches the dev machine's known-good 26.8.1).
ARG NODE_VERSION=26.8.1
# npmmirror's binary mirror is the default: nodejs.org's CDN is not
# reachable from this network's podman VM (same pollution family as the
# docker.io base image above — nodejs.org answers fine from the host).
# On a clean network: --build-arg NODE_DIST_BASE=https://nodejs.org/dist
ARG NODE_DIST_BASE=https://npmmirror.com/mirrors/node
ARG PNPM_VERSION=10.18.3
# DSH_VERSION is resolved by e2e/run-e2e.sh with the same "newest of the
# latest/next dist-tags" rule as the dsh-tui-pi harness. Pin an exact
# version for a deterministic rebuild with --build-arg DSH_VERSION=<version>.
ARG DSH_VERSION=
# npm registry for the in-build installs. Default stays the official
# registry; point it at a mirror (e.g. https://registry.npmmirror.com) when
# the podman VM's route to registry.npmjs.org is degraded.
ARG NPM_REGISTRY=https://registry.npmjs.org

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

# libatomic1: node >= 26 links libatomic.so.1 (node 22 did not) — without it
# the dist-tarball node dies at its first exec on ubuntu 24.04.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils tmux git libatomic1 \
 && rm -rf /var/lib/apt/lists/*

# Node from the official dist tarball — no apt repository dependency,
# arch-agnostic (x64 / arm64).
RUN case "$(uname -m)" in \
      x86_64)  NODE_ARCH=x64 ;; \
      aarch64) NODE_ARCH=arm64 ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSL \
      "${NODE_DIST_BASE}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
 && node --version

# pnpm (the /src workspace install + the runtime profile provisioning run
# `pnpm install`) + the dsh CLI. The global dsh is the CLIENT face's resident
# host runtime: ensureHost (packages/shell/src/client/lifecycle.ts) spawns
# `dsh --profile opentui --no-open --port <n>` from this global closure.
RUN test -n "${DSH_VERSION}" \
      || (echo "DSH_VERSION build arg is required (e.g. --build-arg DSH_VERSION=0.2.2-rc.1)" >&2; exit 1) \
 && npm install -g --no-fund --no-audit --registry "${NPM_REGISTRY}" \
      pnpm@${PNPM_VERSION} \
      "@deepseek-ai/dsh@${DSH_VERSION}" \
 && (dsh --version || true)

WORKDIR /app

# Mock/Jev endpoint env shared by BOTH bake-time-free paths: the scratch
# opentui profile is provisioned + baked at RUNTIME by
# e2e/lib/common.sh:ensure_client_profile (bake-mock-endpoint.mjs reads
# MOCK_BASE_URL; bake-jev-chain.mjs + bake-subagent-registry.mjs add the jev
# dispatch chain and the subagent registry). The key envs only ever carry
# placeholders — no real provider credential ships in this image, and the
# mock keys its phases on the request body, never on auth. JEV_ENDPOINT is
# the env dsh-jev-core resolves the decision endpoint from
# (`env.JEV_ENDPOINT ?? DEFAULT_ENDPOINT`, lib/client.js; key via
# env TYPESAFE_API_KEY, lib/key.js) — any scenario that starts
# e2e/lib/mock-jev.mjs on port 8643 gets the jev layer routed to it with no
# per-boot env; a scenario can still override both vars per boot.
ENV ZAI_CODING_CN_API_KEY=sk-mock-e2e-placeholder \
    MOCK_BASE_URL=http://127.0.0.1:8642/v1 \
    JEV_ENDPOINT=http://127.0.0.1:8643/v1/systemone \
    TYPESAFE_API_KEY=e2e-fake-key

# ---------------------------------------------------------------------------
# CLIENT face (the only face since batch B5): bun + a workspace snapshot at
# /src so the repo-root `./dsh-opentui` launcher (bun --preload ...
# client-entry.tsx) can boot, with ensureHost pulling up the resident
# `dsh --profile opentui` host (node, from the global dsh closure installed
# above).
#
# bun comes from the npm registry (the `bun` package's @oven/* platform
# binaries are regular npm packages, so NPM_REGISTRY applies — no GitHub
# release download, which this network's podman VM cannot reach).
ARG BUN_VERSION=1.4.4
RUN npm install -g --no-fund --no-audit --registry "${NPM_REGISTRY}" \
      bun@${BUN_VERSION} \
 && bun --version

# Workspace snapshot for the client entry. The launcher (SCRIPT_DIR-relative)
# and tsconfigs must sit at their repo-root shapes under /src. node_modules is
# NOT copied: the host tree holds darwin natives and the container needs the
# linux @opentui natives — a fresh pnpm install below resolves the right
# platform binaries from the lockfile. One exception, linked by hand after
# the install: @deepseek-ai/dsh-client-connection resolves ONLY from the
# global dsh closure (it is not on the npm registry — see transport.ts's
# lazy-load note), so the client's connect path needs the same closure link
# the dev workspace carries.
COPY dsh-opentui package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json README.md LICENSE NOTICE CHANGELOG.md /src/
COPY packages /src/packages
RUN find /src -type d -name node_modules -prune -exec rm -rf {} + \
 && pnpm --dir /src install --frozen-lockfile --registry="${NPM_REGISTRY}" \
 && mkdir -p /src/packages/shell/node_modules/@deepseek-ai \
 && ln -sfn /usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-connection \
      /src/packages/shell/node_modules/@deepseek-ai/dsh-client-connection \
 && test -x /src/dsh-opentui \
 && test -d /src/packages/shell/node_modules/@opentui/solid \
 && bun --preload /src/packages/shell/node_modules/@opentui/solid/scripts/preload.js \
      --print '1+1' >/dev/null \
 && echo "[client-face] /src workspace ready"

# The scenario suite is bind-mounted at /e2e by e2e/run-e2e.sh so test logic
# can iterate without an image rebuild.
CMD ["bash", "/e2e/scenarios/run-all.sh"]
