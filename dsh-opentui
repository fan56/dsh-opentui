#!/bin/bash
# dsh-opentui launcher: CLIENT mode (ADR-0005) — a thin bun TUI attaching to
# the resident `dsh --profile opentui` host, which the client spawns/joins
# through the single-instance lifecycle lock.
#
# bun FFI: no NODE_OPTIONS needed on the client path — @opentui/solid is
# bun-native. The solid transform MUST be preloaded (--preload): bun
# transpiles the whole import graph before executing, so a runtime
# registration inside the entry is too late for kit's .tsx modules, and
# packages/shell/bunfig.toml only applies when bun runs from that dir —
# the client launches from the workspace (any cwd).
#
# Plugin mode (the TUI running as a cordis plugin inside the host, formerly
# reachable via `--plugin`, with `--client`/`--v2` as no-op aliases) is
# retired: client mode is the only mode.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec bun --preload "$SCRIPT_DIR/packages/shell/node_modules/@opentui/solid/scripts/preload.js" \
  "$SCRIPT_DIR/packages/shell/src/client-entry.tsx" "$@"
