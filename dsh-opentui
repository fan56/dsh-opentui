#!/bin/bash
# dsh-opentui launcher: boots the real dsh host with the dsh-opentui profile.
# OpenTUI's native core needs node >=26.4 with --experimental-ffi inside the host.
#
# --client: client mode (ADR-0005) — a thin bun TUI attaching to a resident
# host (profile opentui) instead of booting the host in-process. NOTE: the
# default below is still plugin mode; flipping the default to client mode is
# gated on P6 (E2E topology gates) and happens then.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ "${1:-}" = "--client" ]; then
  shift
  # bun FFI: no NODE_OPTIONS needed on the client path — @opentui/solid is
  # bun-native. The solid transform MUST be preloaded (--preload): bun
  # transpiles the whole import graph before executing, so a runtime
  # registration inside the entry is too late for kit's .tsx modules, and
  # packages/shell/bunfig.toml only applies when bun runs from that dir —
  # the client launches from the workspace (any cwd).
  exec bun --preload "$SCRIPT_DIR/packages/shell/node_modules/@opentui/solid/scripts/preload.js" \
    "$SCRIPT_DIR/packages/shell/src/client-entry.tsx" "$@"
fi

case " ${NODE_OPTIONS:-} " in
  *" --experimental-ffi "*) ;;                      # already present, keep as-is
  *) export NODE_OPTIONS="${NODE_OPTIONS:-} --experimental-ffi" ;;
esac

exec dsh --profile dsh-opentui "$@"
