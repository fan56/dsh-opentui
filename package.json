{
  "name": "dsh-opentui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "bun test",
    "test:unit": "node scripts/test-tier.mjs unit",
    "test:ft": "node scripts/test-tier.mjs ft",
    "test:ui": "node scripts/test-tier.mjs ui",
    "test:e2e": "node scripts/test-tier.mjs e2e",
    "test:all": "node scripts/test-tier.mjs all",
    "test:list": "node scripts/test-tier.mjs list",
    "typecheck": "pnpm -r typecheck",
    "typecheck:entry": "cd packages/tui-base && bun run typecheck:entry",
    "verify:assembly": "cd packages/tui-base && bun test -t 'verify:'"
  }
}
