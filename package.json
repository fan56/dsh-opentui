{
  "name": "dsh-opentui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "bun test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:entry": "cd packages/tui-base && bun run typecheck:entry",
    "verify:assembly": "cd packages/tui-base && bun test -t 'verify:'"
  }
}
